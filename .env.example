# Variables de Docker Compose (backend). Copiar a `.env` en la raíz; `.env` no se versiona.
# La API local sin Docker usa services/api/.env (ver services/api/.env.example).

# Local sin Supabase: SQLite dentro del contenedor (los datos se pierden al recrearlo).
DATABASE_URL=sqlite:////tmp/brasaland.db
# Supabase/PostgreSQL: sustituir por la cadena de conexión propia.
# DATABASE_URL=postgresql://usuario:contraseña@host:6543/postgres

# Cambiar por un valor aleatorio propio.
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30

# URL desde la que el usuario abre el backoffice (enlaces de recuperación de contraseña).
FRONTEND_URL=http://localhost:3001

# Sin clave real, el envío de correos de recuperación falla; el resto de la API funciona.
RESEND_API_KEY=your-resend-api-key
RESET_FROM_EMAIL=onboarding@resend.dev
